# ===== フロントエンド (Vite) =====
# Supabase Edge Function のベースURL。
# 例: https://<project-ref>.functions.supabase.co
# ローカルで supabase functions serve を使う場合: http://localhost:54321/functions/v1
VITE_FUNCTIONS_BASE_URL=https://YOUR_PROJECT_REF.functions.supabase.co

# Edge Function 名（デフォルトのままで可）
VITE_CHAT_FUNCTION=chat
VITE_STT_FUNCTION=stt

# Supabase の anon key（Edge Function 呼び出しの Authorization 用）。
# 公開キーなのでフロントに置いてOK。STT/Chat の秘密鍵はサーバー側にのみ置く。
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ===== Edge Function 側 (Supabase Secrets として設定。フロントには出さない) =====
# これらは .env には書かず、`supabase secrets set` で登録する想定。
#   ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
#   OPENAI_API_KEY=sk-xxxxxxxx
